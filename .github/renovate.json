{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "helpers:pinGitHubActionDigests",
    ":gitSignOff"
  ],
  "assignees": ["kkrypt0nn"],
  "dependencyDashboard": {
    "enabled": true,
    "title": "Renovate Dashboard 🤖"
  },
  "minimumReleaseAge": "7 days",
  "rangeStrategy": "pin",
  "rebaseWhen": "conflicted",
  "schedule": ["on friday and saturday"],

  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["/^Dockerfile$/"],
      "matchStrings": [
        "# renovate: datasource=github-tags depName=(?<depName>[^\\s]+)\\s+ARG [A-Z0-9_]+_VERSION=\"(?<currentValue>[^\"]+)\""
      ],
      "datasourceTemplate": "github-tags",
      "versioningTemplate": "semver",
      "extractVersionTemplate": "^v(?<version>.*)$"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/^README\\.md$/"],
      "matchStrings": [
        "- \\[[^\\]]+\\]\\([^\\)]+\\) - Version `(?<currentValue>[^`]+)` <!-- renovate: datasource=github-tags depName=(?<depName>[^\\s]+) -->"
      ],
      "datasourceTemplate": "github-tags",
      "versioningTemplate": "semver",
      "extractVersionTemplate": "^v(?<version>.*)$"
    },

    {
      "customType": "regex",
      "managerFilePatterns": ["/^Dockerfile$/"],
      "matchStrings": [
        "# renovate: datasource=deb depName=(?<depName>[^\\s]+)\\s+ARG [A-Z0-9_]+_VERSION=\"(?<currentValue>[^\"]+)\""
      ],
      "datasourceTemplate": "deb",
      "versioningTemplate": "deb",
      "registryUrlTemplate": "https://archive.ubuntu.com/ubuntu?suite=resolute&components=main,universe,restricted,multiverse&binaryArch=amd64"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/^README\\.md$/"],
      "matchStrings": [
        "- \\[[^\\]]+\\]\\([^\\)]+\\) - Version `(?<currentValue>[^`]+)` <!-- renovate: datasource=deb depName=(?<depName>[^\\s]+) -->"
      ],
      "datasourceTemplate": "deb",
      "versioningTemplate": "deb",
      "registryUrlTemplate": "https://archive.ubuntu.com/ubuntu?suite=resolute&components=main,universe,restricted,multiverse&binaryArch=amd64"
    }
  ],

  "packageRules": [
    {
      "description": "Customize GitHub Actions update PR titles",
      "matchManagers": ["github-actions"],
      "groupName": "GitHub Actions",
      "groupSlug": "github-actions",
      "commitMessagePrefix": "ci(actions):",
      "commitMessageTopic": "{{{groupName}}}",
      "commitMessageExtra": "to {{newVersion}}"
    },
    {
      "description": "Customize tool update PR titles",
      "matchPackageNames": [
        "ReFirmLabs/binwalk",
        "dcfldd",
        "libimage-exiftool-perl",
        "foremost",
        "Yamato-Security/hayabusa",
        "plaso",
        "scalpel",
        "tshark",
        "testdisk",
        "tcpdump",
        "sleuthkit",
        "volatilityfoundation/volatility3",
        "yara",
        "VirusTotal/yara-x"
      ],
      "commitMessagePrefix": "chore(tools):",
      "commitMessageTopic": "{{depName}}",
      "commitMessageExtra": "to {{newVersion}}"
    },
    {
      "description": "Group all GitHub Actions updates",
      "matchManagers": ["github-actions"],
      "groupName": "GitHub Actions",
      "groupSlug": "github-actions"
    },
    {
      "description": "Label Binwalk updates",
      "matchPackageNames": ["ReFirmLabs/binwalk"],
      "addLabels": ["tool/binwalk"]
    },
    {
      "description": "Label dcfldd updates",
      "matchPackageNames": ["dcfldd"],
      "addLabels": ["tool/dcfldd"]
    },
    {
      "description": "Label ExifTool updates",
      "matchPackageNames": ["libimage-exiftool-perl"],
      "addLabels": ["tool/exiftool"]
    },
    {
      "description": "Label Foremost updates",
      "matchPackageNames": ["foremost"],
      "addLabels": ["tool/foremost"]
    },
    {
      "description": "Label Hayabusa updates",
      "matchPackageNames": ["Yamato-Security/hayabusa"],
      "addLabels": ["tool/hayabusa"]
    },
    {
      "description": "Label Plaso updates",
      "matchPackageNames": ["plaso"],
      "addLabels": ["tool/plaso"]
    },
    {
      "description": "Label Scalpel updates",
      "matchPackageNames": ["scalpel"],
      "addLabels": ["tool/scalpel"]
    },
    {
      "description": "Label TShark updates",
      "matchPackageNames": ["tshark"],
      "addLabels": ["tool/tshark"]
    },
    {
      "description": "Label TestDisk & PhotoRec updates",
      "matchPackageNames": ["testdisk"],
      "addLabels": ["tool/testdisk"]
    },
    {
      "description": "Label tcpdump updates",
      "matchPackageNames": ["tcpdump"],
      "addLabels": ["tool/tcpdump"]
    },
    {
      "description": "Label The Sleuth Kit updates",
      "matchPackageNames": ["sleuthkit"],
      "addLabels": ["tool/sleuthkit"]
    },
    {
      "description": "Label Volatility 3 updates",
      "matchPackageNames": ["volatilityfoundation/volatility3"],
      "addLabels": ["tool/volatility3"]
    },
    {
      "description": "Label YARA updates",
      "matchPackageNames": ["yara"],
      "addLabels": ["tool/yara"]
    },
    {
      "description": "Label YARA-X updates",
      "matchPackageNames": ["VirusTotal/yara-x"],
      "addLabels": ["tool/yara-x"]
    }
  ]
}
